# ===================================================================
# HIGH-FREQUENCY ON-CHAIN SIGNAL REPLICATOR & BATCH-SEQUENCING ENGINE
# TARGET NETWORK: Arbitrum Nitro / Robinhood Chain (Chain ID: 4663)
# ===================================================================

# RPC & Sequencer Endpoints
RPC_HTTP_URL=https://rpc.robinhood.com
RPC_WS_URL=wss://rpc.robinhood.com/ws
CHAIN_ID=4663
# Nitro sequencer feed (falls back to RPC_WS_URL)
FEED_URL=wss://feed.mainnet.chain.robinhood.com
# Extra feeds to RACE against FEED_URL (comma separated; backups, relays in other regions).
# Every feed gets its own connection; the first copy of each block wins, duplicates are dropped.
# Repeat a URL to open a second connection to it (round-robin DNS may land on another edge).
# FEED_URLS=wss://feed-backup-1.example.com,wss://feed-backup-2.example.com
# Reconnect a feed that delivered no MESSAGE (pings do not count) for this many seconds.
# 0 = off (default). Only enable on chains that are never legitimately idle.
FEED_DATA_TIMEOUT_SECS=0
# L2 block number of feed message #0 (0 for chains started at Nitro genesis).
# Must be correct, or feed and HTTP-fallback block numbers disagree (Prysm +3 block guard).
FEED_GENESIS_BLOCK=0
# Broadcast endpoints (comma separated)
SEND_RPCS=https://sequencer.mainnet.chain.robinhood.com,https://rpc.mainnet.chain.robinhood.com

# Telegram Interactive Bot Configuration
TELEGRAM_BOT_TOKEN=7891234567:AAExampleTelegramBotTokenHere
# REQUIRED: only this chat may control the bot. 0/unset = the bot ignores everyone.
TELEGRAM_AUTHORIZED_CHAT_ID=123456789

# Master HD Wallet BIP-39 Mnemonic Phrase (12 Words)
# If empty, the engine will automatically generate a new one on startup
MNEMONIC_PHRASE=""

# Watchlist Addresses to Monitor for On-Chain Signals (Comma separated)
WATCHLIST_ACCOUNTS=0x742d35cc6634c0532925a3b844bc454e4438f44e,0x53844f9577c2334e541aec7df7174ece5df1fcf0

# Batch Sequencer Calldata Buffer Configuration (L2 Payload Calibration)
# 0 = lightweight ~93-byte calldata for minimum latency wire broadcast (< 1 ms upload)
BUFFER_SIZE=0
# Floor only: the engine adds intrinsic gas + execution reserve + 1.5x the L1 poster component
# (NodeInterface.gasEstimateL1Component, refreshed every 2 s). Unused gas is refunded.
GAS_LIMIT=600000
# Arbitrum orders transactions first-come-first-served: tips do not buy priority.
MAX_PRIORITY_FEE_GWEI=2.5
# Caps max fee per gas. Balance needed per tx = value + gas_limit x max_fee: keep it near the
# real base fee, or a large gas limit locks a lot of ETH as headroom.
MAX_FEE_GWEI=15.0

# Trading & Risk Parameters
DEFAULT_TRADE_ETH=0.05
SLIPPAGE_PERCENT=1.0
TARGET_PROFIT_PERCENT=35.0
TIME_DECAY_EXIT_SECONDS=45

# Prysm Pola A/B only arm for launch calls INTO these launchpad factory contracts
# (comma separated). Empty = Pola A/B disabled (fail-closed). The contract that emits the
# launch event (T_LAUNCH) must be in this list, or the token/curve never resolves.
PRYSM_LAUNCHPAD_FACTORIES=
# Block the entry should LAND in, relative to the launch block L: 1 = Block +1 (the order fires
# as soon as L is observed and the launch receipt resolves). 0 behaves like 1.
PRYSM_MIN_BLOCK_DELAY=1

# AOT pre-signing: while an entry waits for its launch receipt / target block, the satellite carriers
# (and, once T_LAUNCH resolves, the primary buy) are signed in the background and held as raw bytes;
# the target block only needs socket writes. A held packet is re-signed (same nonce) when the live
# fee or the Revert Guard quote drifted beyond the tolerance, and released when the order is
# cancelled, rejected or older than the max hold.
PRESIGN_ENABLED=true
# Longest a signed packet (and its reserved nonce) may be held before it is released.
PRESIGN_MAX_HOLD_MS=8000
# Re-sign when the staged fee cap is more than this many bps below the live fee (1000 = 10%).
PRESIGN_FEE_TOLERANCE_BPS=1000
# Re-sign when the staged minTokensOut differs from the fresh quote by more than this (200 = 2%).
PRESIGN_QUOTE_TOLERANCE_BPS=200
# ETH/USD reference for market-cap guards (Prysm max MCap, Target take-profit)
ETH_USD_PRICE=2600

# Multi-Account Sequencing (Single or MultiAccount)
EXECUTION_MODE=MultiAccount
SUB_ACCOUNT_COUNT=2
MIN_SUB_ACCOUNT_ETH=0.005
REBALANCE_TARGET_ETH=0.015
